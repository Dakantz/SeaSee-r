# Copy this file to .env and change the values
# --- LOGGING CONFIG ---
LOG_LEVEL=INFO

# --- DATABASE CONFIG ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=super_secure_dev_password_123
POSTGRES_DB=seaseer

# Internal Docker URL (for backend & worker)
DATABASE_URL=postgresql+asyncpg://postgres:super_secure_dev_password_123@db:5432/seaseer

# --- REDIS CONFIG ---
REDIS_URL=redis://redis:6379/0

# --- HOST USER/GROUP PERMISSIONS ---
# Host user UID and GID passed as build arguments to containers (defaults to 1000 if omitted)
UID=1000
GID=1000

