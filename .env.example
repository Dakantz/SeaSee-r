# Copy this file to .env and change the values
# --- LOGGING CONFIG ---
LOG_LEVEL=INFO

# --- DATABASE CONFIG ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=super_secure_dev_password_123
POSTGRES_DB=seaseer

# Internal Docker URL (for backend & worker)
DATABASE_URL=postgresql+asyncpg://postgres:super_secure_dev_password_123@db:5432/seaseer

# --- REDIS CONFIG ---
REDIS_URL=redis://redis:6379/0
REDIS_HOST_PORT=6381

# --- HOST USER/GROUP PERMISSIONS ---
# Host user UID and GID used when building Docker containers
UID=1000
GID=1000

# --- FRONTEND CONFIG ---
VITE_API_URL=http://localhost:8000
VITE_TUS_URL=http://localhost:8080/files/